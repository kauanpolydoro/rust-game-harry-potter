#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository_root"

command -v docker >/dev/null || {
  echo "docker não encontrado; instale Docker com Compose" >&2
  exit 1
}
docker compose version >/dev/null 2>&1 || {
  echo "Docker Compose não encontrado; instale o plugin Compose" >&2
  exit 1
}

echo "Iniciando PostgreSQL, backend, worker de purge e frontend pelo Docker Compose."
echo "A primeira execução baixa as ferramentas e compila o backend."
echo "Após a inicialização, acesse http://127.0.0.1:5173"
echo "Use Ctrl+C para parar os serviços e preservar os dados locais."

exec docker compose --profile dev up --abort-on-container-exit
