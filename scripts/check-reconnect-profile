#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository_root"

docker compose up -d --wait postgres

test_database="hogwarts_reconnect_profile_${RANDOM}_$$"
cleanup_database() {
  docker compose exec -T postgres dropdb --if-exists --force --username hogwarts "$test_database" >/dev/null 2>&1 || true
}
trap cleanup_database EXIT INT TERM

docker compose exec -T postgres createdb --username hogwarts "$test_database"
export TEST_DATABASE_URL="postgres://hogwarts:local-development-only@127.0.0.1:55432/$test_database"

cargo test \
  -p harry-potter-server \
  --test start_game_http \
  reference_reconnect_profile_meets_replay_and_snapshot_slos \
  -- \
  --exact \
  --ignored \
  --nocapture
