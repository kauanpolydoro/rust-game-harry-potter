#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository_root"

docker compose up -d --wait postgres
npm ci

test_database="hogwarts_check_${RANDOM}_$$"
cleanup_database() {
  docker compose exec -T postgres dropdb --if-exists --force --username hogwarts "$test_database" >/dev/null 2>&1 || true
}
trap cleanup_database EXIT INT TERM

docker compose exec -T postgres createdb --username hogwarts "$test_database"
export TEST_DATABASE_URL="postgres://hogwarts:local-development-only@127.0.0.1:55432/$test_database"

cargo fmt --all --check
cargo clippy --workspace --all-targets --all-features -- -D warnings
cargo test --workspace
node scripts/check-boundaries.mjs
npm run generate:check
npm run lint
npm run typecheck
npm test
npm run build
env -u NO_COLOR npm run test:e2e
node scripts/scan-secrets.mjs
