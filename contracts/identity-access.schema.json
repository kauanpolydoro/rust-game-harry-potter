{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hogwarts.invalid/contracts/identity-access.schema.json",
  "title": "IdentityAccessContracts",
  "$defs": {
    "HeroId": {
      "type": "string",
      "enum": ["harry", "hermione", "neville", "ron"]
    },
    "CreateRoomRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "recovery_password"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "recovery_password": { "type": "string", "minLength": 12, "maxLength": 128 }
      }
    },
    "JoinRoomRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "hero_id"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "hero_id": { "$ref": "#/$defs/HeroId" }
      }
    },
    "SelectHeroRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_id"],
      "properties": {
        "hero_id": { "$ref": "#/$defs/HeroId" }
      }
    },
    "SetReadinessRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready"],
      "properties": {
        "ready": { "type": "boolean" }
      }
    },
    "RecoverParticipationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovery_token", "recovery_password", "recovery_attempt_id"],
      "properties": {
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "recovery_password": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recovery_attempt_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "RotateRecoveryPasswordRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_recovery_password", "new_recovery_password"],
      "properties": {
        "current_recovery_password": { "type": "string", "minLength": 1, "maxLength": 128 },
        "new_recovery_password": { "type": "string", "minLength": 12, "maxLength": 128 }
      }
    },
    "RegenerateOwnRecoveryCredentialRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "RegenerateAssistedRecoveryCredentialRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_assistance_risk_acknowledged"],
      "properties": {
        "host_assistance_risk_acknowledged": { "type": "boolean", "enum": [true] }
      }
    },
    "RecoveryParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "position"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "position": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "RecoveryPasswordRotatedSecurityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_version",
        "cursor",
        "type",
        "actor_position",
        "password_generation",
        "occurred_at"
      ],
      "properties": {
        "event_version": { "type": "integer", "enum": [1] },
        "cursor": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["recovery_password_rotated"] },
        "actor_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "password_generation": { "type": "integer", "minimum": 2 },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    },
    "RecoveryCredentialRegeneratedSecurityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_version",
        "cursor",
        "type",
        "actor_position",
        "target_position",
        "delivery",
        "recovery_generation",
        "occurred_at"
      ],
      "properties": {
        "event_version": { "type": "integer", "enum": [1] },
        "cursor": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["recovery_credential_regenerated"] },
        "actor_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "target_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "delivery": { "type": "string", "enum": ["direct", "host_assisted"] },
        "recovery_generation": { "type": "integer", "minimum": 2 },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    },
    "RotateRecoveryPasswordResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["password_generation", "security_event"],
      "properties": {
        "password_generation": { "type": "integer", "minimum": 2 },
        "security_event": { "$ref": "#/$defs/RecoveryPasswordRotatedSecurityEvent" }
      }
    },
    "DirectRecoveryCredentialResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery",
        "participant",
        "recovery_generation",
        "recovery_token",
        "security_event"
      ],
      "properties": {
        "delivery": { "type": "string", "enum": ["direct"] },
        "participant": { "$ref": "#/$defs/RecoveryParticipant" },
        "recovery_generation": { "type": "integer", "minimum": 2 },
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "security_event": { "$ref": "#/$defs/RecoveryCredentialRegeneratedSecurityEvent" }
      }
    },
    "AssistedRecoveryCredentialResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery",
        "participant",
        "recovery_generation",
        "recovery_token",
        "risk_message_key",
        "security_event"
      ],
      "properties": {
        "delivery": { "type": "string", "enum": ["host_assisted"] },
        "participant": { "$ref": "#/$defs/RecoveryParticipant" },
        "recovery_generation": { "type": "integer", "minimum": 2 },
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "risk_message_key": {
          "type": "string",
          "enum": ["participant.recovery.host_assisted_impersonation_risk"]
        },
        "security_event": { "$ref": "#/$defs/RecoveryCredentialRegeneratedSecurityEvent" }
      }
    },
    "SecuritySnapshotMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "cursor", "events"],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [1] },
        "type": { "type": "string", "enum": ["security_snapshot"] },
        "cursor": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/RecoveryPasswordRotatedSecurityEvent" },
              { "$ref": "#/$defs/RecoveryCredentialRegeneratedSecurityEvent" }
            ]
          }
        }
      }
    },
    "SecurityEventsMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "from_cursor", "cursor", "events"],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [1] },
        "type": { "type": "string", "enum": ["security_events"] },
        "from_cursor": { "type": "integer", "minimum": 0 },
        "cursor": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/RecoveryPasswordRotatedSecurityEvent" },
              { "$ref": "#/$defs/RecoveryCredentialRegeneratedSecurityEvent" }
            ]
          }
        }
      }
    },
    "StartGameRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adventure_id", "manifest_digest", "ruleset_version"],
      "properties": {
        "adventure_id": { "type": "string", "minLength": 1 },
        "manifest_digest": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        },
        "ruleset_version": { "type": "string", "minLength": 1 }
      }
    },
    "ExecuteGameCommandRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "expected_state_version", "type"],
      "properties": {
        "command_id": { "type": "string", "format": "uuid" },
        "expected_state_version": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["complete_dark_arts"] }
      }
    },
    "RoomSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$"
        },
        "status": { "type": "string", "enum": ["open"] }
      }
    },
    "HeroSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/HeroId" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "HeroAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "available"],
      "properties": {
        "id": { "$ref": "#/$defs/HeroId" },
        "name": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" }
      }
    },
    "ParticipantSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "role", "position", "ready"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "role": { "type": "string", "enum": ["host", "guest"] },
        "position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "ready": { "type": "boolean" },
        "hero": { "$ref": "#/$defs/HeroSummary" }
      }
    },
    "AdventureOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "playable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "playable": { "type": "boolean" }
      }
    },
    "ContentManifestOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest",
        "manifest_version",
        "content_version",
        "ruleset_version",
        "playable",
        "adventures"
      ],
      "properties": {
        "manifest_digest": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        },
        "manifest_version": { "type": "integer", "minimum": 1 },
        "content_version": { "type": "string", "minLength": 1 },
        "ruleset_version": { "type": "string", "minLength": 1 },
        "playable": { "type": "boolean" },
        "adventures": {
          "type": "array",
          "items": { "$ref": "#/$defs/AdventureOption" }
        }
      }
    },
    "CreateRoomResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room",
        "participant",
        "participants",
        "heroes",
        "content_options",
        "recovery_token"
      ],
      "properties": {
        "room": { "$ref": "#/$defs/RoomSummary" },
        "participant": { "$ref": "#/$defs/ParticipantSummary" },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/$defs/ParticipantSummary" }
        },
        "heroes": {
          "type": "array",
          "items": { "$ref": "#/$defs/HeroAvailability" }
        },
        "content_options": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContentManifestOption" }
        },
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "JoinRoomResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room",
        "participant",
        "participants",
        "heroes",
        "content_options",
        "recovery_token"
      ],
      "properties": {
        "room": { "$ref": "#/$defs/RoomSummary" },
        "participant": { "$ref": "#/$defs/ParticipantSummary" },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/$defs/ParticipantSummary" }
        },
        "heroes": {
          "type": "array",
          "items": { "$ref": "#/$defs/HeroAvailability" }
        },
        "content_options": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContentManifestOption" }
        },
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "FindRoomResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room", "heroes"],
      "properties": {
        "room": { "$ref": "#/$defs/RoomSummary" },
        "heroes": {
          "type": "array",
          "items": { "$ref": "#/$defs/HeroAvailability" }
        }
      }
    },
    "LobbyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room", "participant", "participants", "heroes", "content_options"],
      "properties": {
        "room": { "$ref": "#/$defs/RoomSummary" },
        "participant": { "$ref": "#/$defs/ParticipantSummary" },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/$defs/ParticipantSummary" }
        },
        "heroes": {
          "type": "array",
          "items": { "$ref": "#/$defs/HeroAvailability" }
        },
        "content_options": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContentManifestOption" }
        }
      }
    },
    "GameAdventure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "GameSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "adventure", "expires_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "status": { "type": "string", "enum": ["in_progress"] },
        "adventure": { "$ref": "#/$defs/GameAdventure" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "GameVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "ruleset",
        "manifest",
        "manifest_digest",
        "prng",
        "shuffle",
        "sampling"
      ],
      "properties": {
        "content": { "type": "string", "minLength": 1 },
        "ruleset": { "type": "string", "minLength": 1 },
        "manifest": { "type": "integer", "minimum": 1 },
        "manifest_digest": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        },
        "prng": { "type": "string", "enum": ["chacha20-v1"] },
        "shuffle": { "type": "string", "enum": ["fisher-yates-v1"] },
        "sampling": { "type": "string", "enum": ["rejection-sampling-v1"] }
      }
    },
    "SnapshotSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_version",
        "state_version",
        "sequence",
        "cursor",
        "digest",
        "versions"
      ],
      "properties": {
        "snapshot_version": { "type": "integer", "minimum": 1 },
        "state_version": { "type": "integer", "minimum": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "cursor": { "type": "integer", "minimum": 0 },
        "digest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
        "versions": { "$ref": "#/$defs/GameVersions" }
      }
    },
    "ChoiceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["none"] }
      }
    },
    "TurnSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "phase", "active_position"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "phase": { "type": "string", "enum": ["dark_arts", "hero_action"] },
        "active_position": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "GameParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "role", "position", "hero"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "role": { "type": "string", "enum": ["host", "guest"] },
        "position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "hero": { "$ref": "#/$defs/HeroSummary" }
      }
    },
    "GameProjectionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game",
        "snapshot",
        "turn",
        "participant",
        "participants",
        "legal_actions",
        "choice"
      ],
      "properties": {
        "game": { "$ref": "#/$defs/GameSummary" },
        "snapshot": { "$ref": "#/$defs/SnapshotSummary" },
        "turn": { "$ref": "#/$defs/TurnSummary" },
        "participant": { "$ref": "#/$defs/GameParticipant" },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/$defs/GameParticipant" }
        },
        "legal_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "choice": { "$ref": "#/$defs/ChoiceSummary" }
      }
    },
    "RealtimeGameEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_version",
        "type",
        "sequence",
        "state_version",
        "turn",
        "actor_position"
      ],
      "properties": {
        "event_version": { "type": "integer", "enum": [1] },
        "type": { "type": "string", "enum": ["dark_arts_completed"] },
        "sequence": { "type": "integer", "minimum": 1 },
        "state_version": { "type": "integer", "minimum": 2 },
        "turn": { "type": "integer", "minimum": 1 },
        "actor_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "command_id": { "type": "string", "format": "uuid" }
      }
    },
    "RealtimeSnapshotMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "cursor", "projection"],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [2] },
        "type": { "type": "string", "enum": ["snapshot"] },
        "cursor": { "type": "integer", "minimum": 0 },
        "projection": { "$ref": "#/$defs/GameProjectionResponse" }
      }
    },
    "RealtimeSynchronizedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "cursor",
        "snapshot_version",
        "digest"
      ],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [2] },
        "type": { "type": "string", "enum": ["synchronized"] },
        "cursor": { "type": "integer", "minimum": 0 },
        "snapshot_version": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" }
      }
    },
    "ParticipantPresence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "status"],
      "properties": {
        "position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "status": {
          "type": "string",
          "enum": ["online", "reconnecting", "offline"]
        }
      }
    },
    "RealtimePresenceMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "game_id", "participants", "blocked"],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [2] },
        "type": { "type": "string", "enum": ["presence"] },
        "game_id": { "type": "string", "format": "uuid" },
        "participants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/ParticipantPresence" }
        },
        "required_participant_position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "blocked": { "type": "boolean" }
      }
    },
    "RealtimeEventBatchMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "from_cursor",
        "cursor",
        "events",
        "projection"
      ],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [2] },
        "type": { "type": "string", "enum": ["events"] },
        "from_cursor": { "type": "integer", "minimum": 0 },
        "cursor": { "type": "integer", "minimum": 1 },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/RealtimeGameEvent" }
        },
        "projection": { "$ref": "#/$defs/GameProjectionResponse" }
      }
    },
    "GameCommandReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "type",
        "status",
        "expected_state_version",
        "accepted_state_version",
        "accepted_sequence",
        "expires_at"
      ],
      "properties": {
        "command_id": { "type": "string", "format": "uuid" },
        "type": { "type": "string", "enum": ["complete_dark_arts"] },
        "status": { "type": "string", "enum": ["accepted"] },
        "expected_state_version": { "type": "integer", "minimum": 1 },
        "accepted_state_version": { "type": "integer", "minimum": 2 },
        "accepted_sequence": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "ExecuteGameCommandResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "projection"],
      "properties": {
        "receipt": { "$ref": "#/$defs/GameCommandReceipt" },
        "projection": { "$ref": "#/$defs/GameProjectionResponse" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "category", "retry", "message_key", "details", "correlation_id"],
          "properties": {
            "code": { "type": "string" },
            "category": { "type": "string" },
            "retry": { "type": "string" },
            "message_key": { "type": "string" },
            "details": { "type": "object" },
            "correlation_id": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  }
}
