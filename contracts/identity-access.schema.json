{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hogwarts.invalid/contracts/identity-access.schema.json",
  "title": "IdentityAccessContracts",
  "$comment": "Cross-property x-refinements are mandatory and enforced by scripts/generate-contracts.mjs; consumers must use the generated guards.",
  "$defs": {
    "HeroId": {
      "type": "string",
      "enum": ["harry", "hermione", "neville", "ron"]
    },
    "CreateRoomRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "recovery_password"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "recovery_password": { "type": "string", "minLength": 12, "maxLength": 128 }
      }
    },
    "JoinRoomRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "hero_id"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "hero_id": { "$ref": "#/$defs/HeroId" }
      }
    },
    "SelectHeroRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_id"],
      "properties": {
        "hero_id": { "$ref": "#/$defs/HeroId" }
      }
    },
    "SetReadinessRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready"],
      "properties": {
        "ready": { "type": "boolean" }
      }
    },
    "RecoverParticipationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovery_token", "recovery_password", "recovery_attempt_id"],
      "properties": {
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "recovery_password": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recovery_attempt_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "replace_session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "RotateRecoveryPasswordRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_recovery_password", "new_recovery_password"],
      "properties": {
        "current_recovery_password": { "type": "string", "minLength": 1, "maxLength": 128 },
        "new_recovery_password": { "type": "string", "minLength": 12, "maxLength": 128 }
      }
    },
    "RegenerateOwnRecoveryCredentialRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "RegenerateAssistedRecoveryCredentialRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_assistance_risk_acknowledged"],
      "properties": {
        "host_assistance_risk_acknowledged": { "type": "boolean", "enum": [true] }
      }
    },
    "RecoveryParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "position"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "position": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "RecoveryPasswordRotatedSecurityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_version",
        "cursor",
        "type",
        "actor_position",
        "password_generation",
        "occurred_at"
      ],
      "properties": {
        "event_version": { "type": "integer", "enum": [1] },
        "cursor": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["recovery_password_rotated"] },
        "actor_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "password_generation": { "type": "integer", "minimum": 2 },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    },
    "RecoveryCredentialRegeneratedSecurityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_version",
        "cursor",
        "type",
        "actor_position",
        "target_position",
        "delivery",
        "recovery_generation",
        "occurred_at"
      ],
      "properties": {
        "event_version": { "type": "integer", "enum": [1] },
        "cursor": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["recovery_credential_regenerated"] },
        "actor_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "target_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "delivery": { "type": "string", "enum": ["direct", "host_assisted"] },
        "recovery_generation": { "type": "integer", "minimum": 2 },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    },
    "RotateRecoveryPasswordResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["password_generation", "security_event"],
      "properties": {
        "password_generation": { "type": "integer", "minimum": 2 },
        "security_event": { "$ref": "#/$defs/RecoveryPasswordRotatedSecurityEvent" }
      }
    },
    "DirectRecoveryCredentialResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery",
        "participant",
        "recovery_generation",
        "recovery_token",
        "security_event"
      ],
      "properties": {
        "delivery": { "type": "string", "enum": ["direct"] },
        "participant": { "$ref": "#/$defs/RecoveryParticipant" },
        "recovery_generation": { "type": "integer", "minimum": 2 },
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "security_event": { "$ref": "#/$defs/RecoveryCredentialRegeneratedSecurityEvent" }
      }
    },
    "AssistedRecoveryCredentialResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery",
        "participant",
        "recovery_generation",
        "recovery_token",
        "risk_message_key",
        "security_event"
      ],
      "properties": {
        "delivery": { "type": "string", "enum": ["host_assisted"] },
        "participant": { "$ref": "#/$defs/RecoveryParticipant" },
        "recovery_generation": { "type": "integer", "minimum": 2 },
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "risk_message_key": {
          "type": "string",
          "enum": ["participant.recovery.host_assisted_impersonation_risk"]
        },
        "security_event": { "$ref": "#/$defs/RecoveryCredentialRegeneratedSecurityEvent" }
      }
    },
    "SecuritySnapshotMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "cursor", "events"],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [1] },
        "type": { "type": "string", "enum": ["security_snapshot"] },
        "cursor": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/RecoveryPasswordRotatedSecurityEvent" },
              { "$ref": "#/$defs/RecoveryCredentialRegeneratedSecurityEvent" }
            ]
          }
        }
      }
    },
    "SecurityEventsMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "from_cursor", "cursor", "events"],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [1] },
        "type": { "type": "string", "enum": ["security_events"] },
        "from_cursor": { "type": "integer", "minimum": 0 },
        "cursor": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/RecoveryPasswordRotatedSecurityEvent" },
              { "$ref": "#/$defs/RecoveryCredentialRegeneratedSecurityEvent" }
            ]
          }
        }
      }
    },
    "RecoverySessionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "created_at"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "label": { "type": "string", "enum": ["Sessão 1", "Sessão 2"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "RecoveryReplacementRequiredResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sessions"],
      "properties": {
        "status": { "type": "string", "enum": ["replacement_required"] },
        "sessions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/RecoverySessionSummary" }
        }
      }
    },
    "RecoveredLobbyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recovery_token", "lobby"],
      "properties": {
        "kind": { "type": "string", "enum": ["lobby"] },
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lobby": { "$ref": "#/$defs/LobbyResponse" }
      }
    },
    "RecoveredGameResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recovery_token", "game"],
      "properties": {
        "kind": { "type": "string", "enum": ["game"] },
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "game": { "$ref": "#/$defs/GameProjectionResponse" }
      }
    },
    "StartGameRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adventure_id", "manifest_digest", "ruleset_version"],
      "properties": {
        "adventure_id": { "type": "string", "minLength": 1 },
        "manifest_digest": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        },
        "ruleset_version": { "type": "string", "minLength": 1 }
      }
    },
    "CompleteDarkArtsCommandRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "expected_state_version", "type"],
      "properties": {
        "command_id": { "type": "string", "format": "uuid" },
        "expected_state_version": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["complete_dark_arts"] }
      }
    },
    "ResolveChoiceCommandRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "expected_state_version",
        "type",
        "choice_id",
        "selected_options"
      ],
      "properties": {
        "command_id": { "type": "string", "format": "uuid" },
        "expected_state_version": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["resolve_choice"] },
        "choice_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "selected_options": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "ExecuteGameCommandRequest": {
      "oneOf": [
        { "$ref": "#/$defs/CompleteDarkArtsCommandRequest" },
        { "$ref": "#/$defs/ResolveChoiceCommandRequest" }
      ]
    },
    "RoomSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$"
        },
        "status": { "type": "string", "enum": ["open"] }
      }
    },
    "HeroSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/HeroId" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "HeroAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "available"],
      "properties": {
        "id": { "$ref": "#/$defs/HeroId" },
        "name": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" }
      }
    },
    "ParticipantSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "role", "position", "ready"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "role": { "type": "string", "enum": ["host", "guest"] },
        "position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "ready": { "type": "boolean" },
        "hero": { "$ref": "#/$defs/HeroSummary" }
      }
    },
    "AdventureOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "playable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "playable": { "type": "boolean" }
      }
    },
    "ContentManifestOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest",
        "manifest_version",
        "content_version",
        "ruleset_version",
        "playable",
        "adventures"
      ],
      "properties": {
        "manifest_digest": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        },
        "manifest_version": { "type": "integer", "minimum": 1 },
        "content_version": { "type": "string", "minLength": 1 },
        "ruleset_version": { "type": "string", "minLength": 1 },
        "playable": { "type": "boolean" },
        "adventures": {
          "type": "array",
          "items": { "$ref": "#/$defs/AdventureOption" }
        }
      }
    },
    "CreateRoomResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room",
        "participant",
        "participants",
        "heroes",
        "content_options",
        "recovery_token"
      ],
      "properties": {
        "room": { "$ref": "#/$defs/RoomSummary" },
        "participant": { "$ref": "#/$defs/ParticipantSummary" },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/$defs/ParticipantSummary" }
        },
        "heroes": {
          "type": "array",
          "items": { "$ref": "#/$defs/HeroAvailability" }
        },
        "content_options": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContentManifestOption" }
        },
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "JoinRoomResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room",
        "participant",
        "participants",
        "heroes",
        "content_options",
        "recovery_token"
      ],
      "properties": {
        "room": { "$ref": "#/$defs/RoomSummary" },
        "participant": { "$ref": "#/$defs/ParticipantSummary" },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/$defs/ParticipantSummary" }
        },
        "heroes": {
          "type": "array",
          "items": { "$ref": "#/$defs/HeroAvailability" }
        },
        "content_options": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContentManifestOption" }
        },
        "recovery_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "FindRoomResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room", "heroes"],
      "properties": {
        "room": { "$ref": "#/$defs/RoomSummary" },
        "heroes": {
          "type": "array",
          "items": { "$ref": "#/$defs/HeroAvailability" }
        }
      }
    },
    "LobbyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room", "participant", "participants", "heroes", "content_options"],
      "properties": {
        "room": { "$ref": "#/$defs/RoomSummary" },
        "participant": { "$ref": "#/$defs/ParticipantSummary" },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/$defs/ParticipantSummary" }
        },
        "heroes": {
          "type": "array",
          "items": { "$ref": "#/$defs/HeroAvailability" }
        },
        "content_options": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContentManifestOption" }
        }
      }
    },
    "GameAdventure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "GameSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "adventure", "expires_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "status": { "type": "string", "enum": ["in_progress", "won", "lost"] },
        "adventure": { "$ref": "#/$defs/GameAdventure" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "GameVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "ruleset",
        "manifest",
        "manifest_digest",
        "prng",
        "shuffle",
        "sampling"
      ],
      "properties": {
        "content": { "type": "string", "minLength": 1 },
        "ruleset": { "type": "string", "minLength": 1 },
        "manifest": { "type": "integer", "minimum": 1 },
        "manifest_digest": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        },
        "prng": { "type": "string", "enum": ["chacha20-v1"] },
        "shuffle": { "type": "string", "enum": ["fisher-yates-v1"] },
        "sampling": { "type": "string", "enum": ["rejection-sampling-v1"] }
      }
    },
    "SnapshotSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_version",
        "state_version",
        "sequence",
        "cursor",
        "digest",
        "versions"
      ],
      "properties": {
        "snapshot_version": { "type": "integer", "minimum": 1 },
        "state_version": { "type": "integer", "minimum": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "cursor": { "type": "integer", "minimum": 0 },
        "digest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
        "versions": { "$ref": "#/$defs/GameVersions" }
      }
    },
    "NoChoiceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["none"] }
      }
    },
    "PendingEffectChoiceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "id",
        "cause",
        "responsible_position",
        "kind",
        "options",
        "min",
        "max"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["pending"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "cause": { "type": "string", "minLength": 1, "maxLength": 256 },
        "responsible_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "kind": { "type": "string", "enum": ["effect"] },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "min": { "type": "integer", "enum": [1] },
        "max": { "type": "integer", "enum": [1] }
      }
    },
    "PendingTargetChoiceSummary": {
      "type": "object",
      "additionalProperties": false,
      "x-refinements": ["min_lte_max", "max_lt_options_length"],
      "required": [
        "status",
        "id",
        "cause",
        "responsible_position",
        "kind",
        "options",
        "min",
        "max"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["pending"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "cause": { "type": "string", "minLength": 1, "maxLength": 256 },
        "responsible_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "kind": { "type": "string", "enum": ["target"] },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "min": { "type": "integer", "minimum": 0, "maximum": 32 },
        "max": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "PendingChoiceSummary": {
      "oneOf": [
        { "$ref": "#/$defs/PendingEffectChoiceSummary" },
        { "$ref": "#/$defs/PendingTargetChoiceSummary" }
      ]
    },
    "ChoiceSummary": {
      "oneOf": [
        { "$ref": "#/$defs/NoChoiceSummary" },
        { "$ref": "#/$defs/PendingChoiceSummary" }
      ]
    },
    "GameResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "attack", "influence"],
      "properties": {
        "health": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "attack": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "influence": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "EffectOutcomeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rule_id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["die_rolled", "moved", "no_op", "resource_changed", "terminal"]
        },
        "rule_id": { "type": "string", "minLength": 1 },
        "target_id": { "type": "string", "minLength": 1 },
        "target_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "die": { "type": "string", "enum": ["d4", "d6", "d8"] },
        "result": { "type": "integer", "minimum": 1, "maximum": 8 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "reason": {
          "type": "string",
          "enum": ["explicit", "no_eligible_target", "zero_cardinality"]
        },
        "resource": {
          "type": "string",
          "enum": ["attack", "control", "health", "influence"]
        },
        "before": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "after": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "cause": { "type": "string", "enum": ["cost", "effect"] },
        "outcome": { "type": "string", "enum": ["lost", "won"] }
      }
    },
    "EffectResolutionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "outcomes"],
      "properties": {
        "status": { "type": "string", "enum": ["idle", "resolved", "choice", "terminal"] },
        "outcomes": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/EffectOutcomeSummary" }
        }
      }
    },
    "TurnSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "phase", "active_position"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "phase": { "type": "string", "enum": ["dark_arts", "hero_action"] },
        "active_position": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "GameParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "role", "position", "hero", "resources"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "role": { "type": "string", "enum": ["host", "guest"] },
        "position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "hero": { "$ref": "#/$defs/HeroSummary" },
        "resources": { "$ref": "#/$defs/GameResources" }
      }
    },
    "GameProjectionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game",
        "snapshot",
        "turn",
        "participant",
        "participants",
        "legal_actions",
        "choice",
        "effects"
      ],
      "properties": {
        "game": { "$ref": "#/$defs/GameSummary" },
        "snapshot": { "$ref": "#/$defs/SnapshotSummary" },
        "turn": { "$ref": "#/$defs/TurnSummary" },
        "participant": { "$ref": "#/$defs/GameParticipant" },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/$defs/GameParticipant" }
        },
        "legal_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["complete_dark_arts", "resolve_choice"]
          }
        },
        "choice": { "$ref": "#/$defs/ChoiceSummary" },
        "effects": { "$ref": "#/$defs/EffectResolutionSummary" }
      }
    },
    "DarkArtsCompletedRealtimeGameEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_version",
        "type",
        "sequence",
        "state_version",
        "turn",
        "actor_position",
        "effects",
        "effect_stop",
        "prng_counter"
      ],
      "properties": {
        "event_version": { "type": "integer", "enum": [1, 2, 3] },
        "type": { "type": "string", "enum": ["dark_arts_completed"] },
        "sequence": { "type": "integer", "minimum": 1 },
        "state_version": { "type": "integer", "minimum": 2 },
        "turn": { "type": "integer", "minimum": 1 },
        "actor_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "effects": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/EffectOutcomeSummary" }
        },
        "effect_stop": { "type": "string", "enum": ["stable", "choice", "terminal"] },
        "choice": { "$ref": "#/$defs/PendingChoiceSummary" },
        "prng_counter": { "type": "integer", "minimum": 0 },
        "command_id": { "type": "string", "format": "uuid" }
      },
      "allOf": [
        {
          "if": {
            "required": ["effect_stop"],
            "properties": { "effect_stop": { "const": "choice" } }
          },
          "then": { "required": ["choice"] },
          "else": { "not": { "required": ["choice"] } }
        }
      ]
    },
    "ChoiceResolvedRealtimeGameEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_version",
        "type",
        "sequence",
        "state_version",
        "turn",
        "actor_position",
        "choice_id",
        "choice_cause",
        "selected_options",
        "effects",
        "effect_stop",
        "prng_counter"
      ],
      "properties": {
        "event_version": { "type": "integer", "enum": [3] },
        "type": { "type": "string", "enum": ["choice_resolved"] },
        "sequence": { "type": "integer", "minimum": 1 },
        "state_version": { "type": "integer", "minimum": 2 },
        "turn": { "type": "integer", "minimum": 1 },
        "actor_position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "choice_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "choice_cause": { "type": "string", "minLength": 1, "maxLength": 256 },
        "selected_options": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "effects": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/EffectOutcomeSummary" }
        },
        "effect_stop": { "type": "string", "enum": ["stable", "choice", "terminal"] },
        "choice": { "$ref": "#/$defs/PendingChoiceSummary" },
        "prng_counter": { "type": "integer", "minimum": 0 },
        "command_id": { "type": "string", "format": "uuid" }
      },
      "allOf": [
        {
          "if": {
            "required": ["effect_stop"],
            "properties": { "effect_stop": { "const": "choice" } }
          },
          "then": { "required": ["choice"] },
          "else": { "not": { "required": ["choice"] } }
        }
      ]
    },
    "RealtimeGameEvent": {
      "oneOf": [
        { "$ref": "#/$defs/DarkArtsCompletedRealtimeGameEvent" },
        { "$ref": "#/$defs/ChoiceResolvedRealtimeGameEvent" }
      ]
    },
    "RealtimeSnapshotMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "cursor", "projection"],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [2] },
        "type": { "type": "string", "enum": ["snapshot"] },
        "cursor": { "type": "integer", "minimum": 0 },
        "projection": { "$ref": "#/$defs/GameProjectionResponse" }
      }
    },
    "RealtimeSynchronizedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "cursor",
        "snapshot_version",
        "digest"
      ],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [2] },
        "type": { "type": "string", "enum": ["synchronized"] },
        "cursor": { "type": "integer", "minimum": 0 },
        "snapshot_version": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" }
      }
    },
    "ParticipantPresence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "status"],
      "properties": {
        "position": { "type": "integer", "minimum": 1, "maximum": 4 },
        "status": {
          "type": "string",
          "enum": ["online", "reconnecting", "offline"]
        }
      }
    },
    "RealtimePresenceMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "game_id", "participants", "blocked"],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [2] },
        "type": { "type": "string", "enum": ["presence"] },
        "game_id": { "type": "string", "format": "uuid" },
        "participants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/ParticipantPresence" }
        },
        "required_participant_position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "blocked": { "type": "boolean" }
      }
    },
    "RealtimeEventBatchMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "from_cursor",
        "cursor",
        "events",
        "projection"
      ],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [2] },
        "type": { "type": "string", "enum": ["events"] },
        "from_cursor": { "type": "integer", "minimum": 0 },
        "cursor": { "type": "integer", "minimum": 1 },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/RealtimeGameEvent" }
        },
        "projection": { "$ref": "#/$defs/GameProjectionResponse" }
      }
    },
    "GameCommandReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "type",
        "status",
        "expected_state_version",
        "accepted_state_version",
        "accepted_sequence",
        "expires_at"
      ],
      "properties": {
        "command_id": { "type": "string", "format": "uuid" },
        "type": {
          "type": "string",
          "enum": ["complete_dark_arts", "resolve_choice"]
        },
        "status": { "type": "string", "enum": ["accepted"] },
        "expected_state_version": { "type": "integer", "minimum": 1 },
        "accepted_state_version": { "type": "integer", "minimum": 2 },
        "accepted_sequence": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "ExecuteGameCommandResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "projection"],
      "properties": {
        "receipt": { "$ref": "#/$defs/GameCommandReceipt" },
        "projection": { "$ref": "#/$defs/GameProjectionResponse" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "category", "retry", "message_key", "details", "correlation_id"],
          "properties": {
            "code": { "type": "string" },
            "category": { "type": "string" },
            "retry": { "type": "string" },
            "message_key": { "type": "string" },
            "details": { "type": "object" },
            "correlation_id": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  }
}
